---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import { features } from '../content/home.ts';
---

<Base title="Decoupage Screenwriting — write & produce your film, on Mac">
  <Hero />
  <FeatureGrid features={features} />
  <p class="draft-note"><em>Draft copy + placeholder screenshots — Steve edits the copy; real screenshots drop into <code>public/img/</code>.</em></p>
</Base>

<style>
  .draft-note { text-align: center; color: var(--muted); font-size: var(--step--1); margin-top: 2rem; }
</style>
