---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import { showcases, features } from '../content/home.ts';
---

<Base title="Decoupage Screenwriting — write & produce your film, on Mac">
  <Hero />
  {showcases.map((item) => <Showcase item={item} />)}
  <FeatureGrid features={features} />
  <p class="draft-note"><em>Draft copy — Steve edits.</em></p>
</Base>

<style>
  .draft-note { text-align: center; color: var(--muted); font-size: var(--step--1); margin-top: 2rem; }
</style>
