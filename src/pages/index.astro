---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import { getHome, getSiteMeta } from '../lib/content';

const home = await getHome();
const meta = await getSiteMeta();
const primaryCta = { label: 'Get it on the Mac App Store', href: meta.appStoreUrl || '#' };
const secondaryCta = { label: 'Support', href: '/support' };
---

<Base title="Decoupage Screenwriting — write & produce your film, on Mac">
  <Hero tagline={home.tagline} subhead={home.subhead} primaryCta={primaryCta} secondaryCta={secondaryCta} />
  {home.showcases.map((item) => <Showcase item={item} />)}
  <FeatureGrid features={home.features} />
</Base>
