---
import '../styles/tokens.css';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Screenwriting and film production in one Mac app.' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/support', label: 'Support' },
  { href: '/bible/', label: 'Manual' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F5F1E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1B1917" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <header class="site-header">
      <Wordmark href="/" size="sm" />
      <nav>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© 2026 Steve Brock</p>
      <nav>
        <a href="/privacy">Privacy</a>
        <a href="/support">Support</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html {
    color-scheme: light dark;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    line-height: 1.65;
    background: var(--paper);
    color: var(--ink);
    -webkit-text-size-adjust: 100%;
  }
  body { margin: 0; min-height: 100dvh; display: flex; flex-direction: column; }
  main { flex: 1; width: 100%; max-width: 72ch; margin: 0 auto; padding: 2.5rem 1.25rem; }

  h1, h2, h3 { font-family: var(--font-serif); font-weight: 600; line-height: 1.15; text-wrap: balance; }
  h1 { font-size: var(--step-3); }
  h2 { font-size: var(--step-2); }
  a { color: var(--clay); }
  img { max-width: 100%; height: auto; }
  :focus-visible { outline: 2px solid var(--clay); outline-offset: 2px; border-radius: 3px; }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: 72ch;
    margin: 0 auto;
    padding: 1.1rem 1.25rem;
    flex-wrap: wrap;
  }
  .site-header nav, .site-footer nav { display: flex; gap: 1.25rem; }
  .site-header nav a, .site-footer nav a { color: var(--muted); text-decoration: none; font-size: var(--step--1); }
  .site-header nav a:hover, .site-footer nav a:hover { color: var(--clay); }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: var(--step--1); }
  .site-footer p { margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
  }
</style>
