---
// App screenshot. If `src` is set, renders the image; otherwise a labeled placeholder box
// (16:10, subtle) so the layout reads intentionally until real screenshots land.
interface Props {
  src?: string;
  label: string;
  ratio?: string;
}
const { src, label, ratio = '16 / 10' } = Astro.props;
---
{src ? (
  <img class="shot" src={src} alt={label} loading="lazy" style={`aspect-ratio:${ratio}`} />
) : (
  <div class="shot shot--placeholder" style={`aspect-ratio:${ratio}`} role="img" aria-label={`Screenshot placeholder: ${label}`}>
    <span>{label}</span>
    <small>screenshot</small>
  </div>
)}

<style>
  .shot {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    display: block;
    object-fit: cover;
  }
  .shot--placeholder {
    display: grid;
    place-content: center;
    gap: 0.25rem;
    text-align: center;
    color: var(--muted);
    background:
      repeating-linear-gradient(45deg, transparent 0 14px, color-mix(in srgb, var(--muted) 6%, transparent) 14px 15px),
      var(--paper-2);
  }
  .shot--placeholder span { font-family: var(--font-serif); font-size: var(--step-1); color: var(--ink); }
  .shot--placeholder small { text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.7rem; }
</style>
