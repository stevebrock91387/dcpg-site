---
import Screenshot from './Screenshot.astro';
import type { Feature } from '../content/home.ts';
interface Props { features: Feature[]; }
const { features } = Astro.props;
---
<section class="features">
  {features.map((f) => (
    <article class="feature">
      {f.shot && <Screenshot src={f.shot.src} label={f.shot.label} />}
      <h2>{f.title}</h2>
      <p>{f.body}</p>
    </article>
  ))}
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22ch), 1fr));
    gap: 2rem 1.75rem;
    margin: 2rem 0;
  }
  .feature { display: grid; gap: 0.5rem; align-content: start; }
  .feature h2 { font-size: var(--step-1); margin: 0.4rem 0 0; }
  .feature p { color: var(--muted); margin: 0; }
</style>
